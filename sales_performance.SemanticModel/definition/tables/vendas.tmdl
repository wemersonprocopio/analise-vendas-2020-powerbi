				  #"Texto aparado" = Table.TransformColumns(#"Tipo de coluna alterado", {{"Marca", Text.Trim, type text}}),
				  #"Duplicatas removidas" = Table.Distinct(#"Texto aparado")
				in
				  #"Duplicatas removidas"

	annotation PBI_ResultType = Table

