	/// Nome do estado a partir da Região Destino, para o mapa.
	column Estado =
			VAR _uf = TRIM ( RIGHT ( vendas[Região Destino], 2 ) )
			RETURN
			    SWITCH ( _uf,
			        "SP", "São Paulo", "RJ", "Rio de Janeiro", "ES", "Espírito Santo", "MG", "Minas Gerais",
			        "BA", "Bahia", "MA", "Maranhão", "AM", "Amazonas", "PR", "Paraná", "SC", "Santa Catarina",
			        "RS", "Rio Grande do Sul", "PE", "Pernambuco", "CE", "Ceará", "GO", "Goiás", "DF", "Distrito Federal",
			        _uf )
		lineageTag: 1dce2dd6-0440-456a-a177-a444a5607873
		dataCategory: StateOrProvince
		summarizeBy: none

	/// País de destino, para o mapa.
	column País = "Brasil"
		lineageTag: 1254f080-6c70-489a-8feb-0c9b2de451aa
		dataCategory: Country
		summarizeBy: none

	partition vendas = m
		mode: import
		source =
				let
				  Origem = Excel.Workbook(File.Contents("C:\Users\Acer\OneDrive\claude\12_powerbi\6_sales_performance\vendas.xlsx"), null, true),
				  #"Navegação 1" = Origem{[Item = "Planilha1", Kind = "Sheet"]}[Data],
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(#"Navegação 1", [PromoteAllScalars = true]),
